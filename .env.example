# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.

# ---- back-end ----
OPENAI_API_KEY=coloque-sua-chave-aqui
OPENAI_MODEL=gpt-6-luna
# none, low, medium... (deixe vazio se trocar para um modelo que não aceita esse campo)
OPENAI_REASONING_EFFORT=low
# quem pode chamar a API pelo navegador (separado por vírgula, nunca use *)
CORS_ORIGINS=http://localhost:8501

# ---- front-end (só quando rodar sem Docker) ----
API_URL=http://localhost:8000
